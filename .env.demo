# Used by "npm run dev:demo" (Vite loads .env.demo in "demo" mode).
# A second copy of the app on port 5174 talking to its own json-server on
# port 3002, with the example data, so it never touches my real db.json.
# Nothing secret here, so it can be in git (like .env.example).
VITE_API_URL=http://localhost:3002
VITE_RATES_URL=https://api.frankfurter.dev/v1
