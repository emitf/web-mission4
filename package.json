{
  "name": "clear-count",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/first-run.js",
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"json-server db.json --port 3001\"",
    "predev:demo": "node scripts/first-run.js && node scripts/demo-data.js",
    "dev:demo": "concurrently -n demo-web,demo-api -c green,yellow \"vite --mode demo --port 5174 --strictPort\" \"json-server db.demo.json --port 3002\"",
    "preapi": "node scripts/first-run.js",
    "api": "json-server db.json --port 3001",
    "prebuild": "node scripts/first-run.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-devtools": "^5.108.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "json-server": "^1.0.0-beta.15",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
