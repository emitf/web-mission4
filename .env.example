# Copy this file to .env (cp .env.example .env)
# Only variables starting with VITE_ reach the browser, so never put secrets here.

# My json-server (accounts, movements, IOUs)
VITE_API_URL=http://localhost:3001

# Public exchange rates from the European Central Bank (Frankfurter, no key needed)
VITE_RATES_URL=https://api.frankfurter.dev/v1
